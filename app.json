{
  "expo": {
    "name": "Naam Japa",
    "slug": "naam-japa",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1E0B2B"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.naamjapa.reminders",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "plugins": [
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose a wallpaper picture to show when a japa reminder opens."
        }
      ]
    ]
  }
}
